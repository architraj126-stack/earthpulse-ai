# EarthPulse AI Environment Configuration
# Copy this file to .env for production overrides.

ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# NASA POWER API Gateway (Free, public, no key required)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal

# Security & CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=120
